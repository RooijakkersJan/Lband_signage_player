<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:orientation="horizontal"
    android:padding="10dp"
    tools:context="com.ApplicationAddonsSignage.activities.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"> <!-- Light translucent background to differentiate the section -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight=".38"
                android:gravity="center"
                >

                <ImageView
                    android:id="@+id/imageLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/login_icon_margin_bottom"
                    android:src="@drawable/smclogin" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight=".14"
                >
                <EditText
                    android:layout_marginLeft="@dimen/margin_left_for_tv"
                    android:layout_marginRight="@dimen/margin_right_for_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_back"
                    android:drawableLeft="@drawable/user_name"
                    android:hint="User Name"
                    android:textColorHint="@color/black"
                    android:id="@+id/edit_username"
                    android:singleLine="true"
                    android:inputType="textEmailAddress"
                    />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight=".14"
                >

                <EditText
                    android:layout_marginLeft="@dimen/margin_left_for_tv"
                    android:layout_marginRight="@dimen/margin_right_for_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_back"
                    android:drawableLeft="@drawable/token_no"
                    android:hint="Token No"
                    android:id="@+id/edit_tokenNo"
                    android:singleLine="true"
                    android:inputType="text"
                    android:textColorHint="@color/black"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight=".13"
                android:visibility="gone"
                >
                <EditText
                    android:layout_marginLeft="@dimen/margin_left_for_tv"
                    android:layout_marginRight="@dimen/margin_right_for_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_back"
                    android:drawableLeft="@drawable/dealer_code"
                    android:hint="Dealer Code"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:id="@+id/edit_dealerCode"
                    android:textColorHint="@color/black"
                    android:visibility="gone"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight=".21"
                android:weightSum="2"
                android:orientation="horizontal"
                >

                <ImageButton
                    android:id="@+id/btn_Cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/cancelogin"
                    />

                <ImageButton
                    android:id="@+id/btn_Submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/submitlogin"
                    />

            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"> <!-- Light translucent background to differentiate the section -->


            <ImageView
                android:id="@+id/image_qr_code"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="QR Code Scanner Area"
                android:src="@drawable/download1" />

            <!-- Replace this ImageView with your barcode scanner view if integrating a live camera -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Scan QR Code to Login"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>


    </LinearLayout>


</LinearLayout>


